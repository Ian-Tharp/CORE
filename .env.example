# CORE — root .env (read by Docker Compose for variable interpolation).
# Copy to `.env` and adjust for your machine. All values have safe defaults,
# so an empty/absent .env still brings the stack up. This file documents the
# knobs each person may want to set locally. (App/runtime secrets like
# OPENAI_API_KEY / ANTHROPIC_API_KEY live in backend/.env, not here.)

# --- Local LLM provider ---------------------------------------------------
# CORE's local inference provider: "lmstudio" (default) or "ollama".
CORE_LOCAL_PROVIDER=lmstudio
# Default local model id (must be loaded in your provider).
CORE_DEFAULT_MODEL=

# --- LM Studio (default local provider) -----------------------------------
# LM Studio runs on the HOST (Developer tab -> Start Server, port 1234).
# From inside the containers the host is reached via host.docker.internal.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Comma-separated id(s) of the model(s) you have loaded in LM Studio.
LMSTUDIO_MODELS=

# --- Ollama (OPTIONAL container; only used with `--profile ollama`) --------
# Where Ollama stores its models. Defaults to a named Docker volume
# (machine-agnostic, zero config). Set this to an existing host models dir to
# reuse already-downloaded models. Examples:
#   Windows:      OLLAMA_MODELS_DIR=C:/Users/<you>/.ollama
#   macOS/Linux:  OLLAMA_MODELS_DIR=${HOME}/.ollama
# OLLAMA_MODELS_DIR=ollama-data
